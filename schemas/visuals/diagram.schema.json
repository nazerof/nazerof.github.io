{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nazerof.github.io/schemas/visuals/diagram.schema.json",
  "allOf": [{ "$ref": "core.schema.json#/$defs/core" }],
  "type": "object",
  "required": ["groups", "nodes", "edges", "notes", "layout"],
  "properties": {
    "kind": { "const": "diagram" },
    "groups": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "label"],
        "properties": { "id": { "$ref": "core.schema.json#/$defs/id" }, "label": { "$ref": "core.schema.json#/$defs/text" } }
      }
    },
    "nodes": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "kind", "group", "x", "y", "width", "height", "accessibilityLabel"],
        "properties": {
          "id": { "$ref": "core.schema.json#/$defs/id" },
          "label": { "$ref": "core.schema.json#/$defs/text" },
          "kind": { "enum": ["scheduler", "boundary", "service", "connector", "process", "storage", "monitor", "dashboard"] },
          "group": { "$ref": "core.schema.json#/$defs/id" },
          "x": { "type": "number", "minimum": 0, "maximum": 1600 },
          "y": { "type": "number", "minimum": 0, "maximum": 900 },
          "width": { "type": "number", "minimum": 80, "maximum": 360 },
          "height": { "type": "number", "minimum": 44, "maximum": 180 },
          "accessibilityLabel": { "$ref": "core.schema.json#/$defs/text" }
        }
      }
    },
    "edges": {
      "type": "array", "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "from", "to", "label", "flow"],
        "properties": {
          "id": { "$ref": "core.schema.json#/$defs/id" },
          "from": { "$ref": "core.schema.json#/$defs/id" },
          "to": { "$ref": "core.schema.json#/$defs/id" },
          "label": { "$ref": "core.schema.json#/$defs/text" },
          "flow": { "enum": ["happy", "failure", "observability"] }
        }
      }
    },
    "notes": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "text", "nodeRefs"],
        "properties": {
          "id": { "$ref": "core.schema.json#/$defs/id" },
          "text": { "$ref": "core.schema.json#/$defs/text" },
          "nodeRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "core.schema.json#/$defs/id" } }
        }
      }
    },
    "layout": {
      "type": "object", "additionalProperties": false, "required": ["direction", "spacing"],
      "properties": { "direction": { "const": "left-to-right" }, "spacing": { "type": "number", "minimum": 20, "maximum": 200 } }
    }
  },
  "unevaluatedProperties": false
}
